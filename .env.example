# Modèle de .env (ou de .env.local pour un autre projet) : remplir avec la configuration web du projet Firebase
# (console Firebase > Paramètres du projet > Vos applications > Configuration du SDK).
# Sans ces valeurs, l'app enregistre les images seulement dans le navigateur.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
